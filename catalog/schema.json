{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["skills"],
  "properties": {
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "category",
          "source",
          "license",
          "compatibility",
          "security"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "source": { "type": "object", "required": ["type", "ref"] },
          "license": { "type": "string" },
          "security": { "type": "object", "required": ["reviewed"] }
        }
      }
    }
  }
}
